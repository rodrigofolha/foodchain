{
 "title": "Throughput with 512 clients at 12 s blocks, redone without the artefacts of run F2",
 "measured": "2026-10-19 local time (2026-10-20 00:19 to 01:12 UTC on the host clock); local in-process Hardhat network only, nothing sent to any network",
 "host": "12th Gen Intel Core i5-12500H (16 threads), 15.8 GB, WSL2, Node v20.20.2, Hardhat 2.28.6",
 "commandPrefix": "cd <repository> && <environment> RESULTS_DIR=<results folder> npx hardhat run benchmarking/benchmark-concurrent.cjs --no-compile (through a wrapper script, not published)",
 "settings": {
  "WITHDRAW_GAS_LIMIT": {
   "value": 1392000,
   "what": "fixed poolWithdraw gas limit = the manager dApp rule (node estimate x 1.2) at the largest gasUsed of the earlier 12 s runs (1,150,948 x 1.2094, the ratio of the dApp limit to gasUsed in run B)",
   "whyNotWITHDRAW_ESTIMATE": "a per-withdrawal estimate on the mining EVM took about 0.8 s each, one at a time (smoke test: withdrawal preparation 0.83-1.11 s against 0.04 s); for 512 withdrawals about 400 s of the mining thread"
  },
  "STIPEND_FACTOR": {
   "value": 10,
   "why": "only the amount moved changes, not the gas; it must not bind: the level gas (512 x 4.84 M = 41.3 blocks of 60 M) lets the base fee rise at most 1.125^41.3 = 130 times, from 0.066 to 8.5 gwei, so the price at the withdrawal is at most 9.5 gwei against 1.061 at the order (8.96 times), and at a 1,392,000 limit the factor needed is at most 7.8"
  },
  "FEES_PER_TX": {
   "value": 1,
   "what": "ethers reads 2 x base fee of the latest block + eth_maxPriorityFeePerGas for each transaction"
  },
  "FEE_CAP_GWEI": {
   "value": 20,
   "runs": [
    "H256",
    "H512"
   ],
   "why": "added after G512: with per-transaction fees a waiting transaction keeps the cap of the moment it was signed; once the base fee rises its effective tip (cap - base fee) falls below the full 1 gwei of fresher transactions and it is passed over, then priced out once the base fee passes its cap. 20 gwei is above 2 x 8.5 + 1 = 18 gwei (the ethers rule at the highest reachable base fee); every transaction pays base fee + tip whatever the cap. The one-time address sends EIP-1559 too, its maximum fee lowered to what its balance covers (12.2 gwei for the withdrawal at factor 10)."
  },
  "FEE_TRACE": {
   "value": 1,
   "what": "block rows (gas used, base fee) and the stipend price per makeOrder are written; no effect on the run"
  }
 },
